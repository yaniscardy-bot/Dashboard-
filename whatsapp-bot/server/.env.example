# --- Meta WhatsApp Cloud API ---
# Token d'accès permanent ou temporaire généré dans developers.facebook.com
WHATSAPP_ACCESS_TOKEN=
# ID du numéro de téléphone WhatsApp Business (visible dans le tableau de bord Meta)
WHATSAPP_PHONE_NUMBER_ID=
# Chaîne arbitraire que vous choisissez, à re-saisir dans la config du webhook Meta
WHATSAPP_VERIFY_TOKEN=change-moi
# App Secret (onglet "Paramètres de base" de l'app Meta) — active la vérification
# de signature des requêtes entrantes. Fortement recommandé en production.
WHATSAPP_APP_SECRET=

# Numéros autorisés à écrire des données (format E.164 sans le +, ex: 33612345678)
# séparés par des virgules. Toute autre expéditeur est ignoré.
ALLOWED_SENDERS=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Serveur ---
PORT=3000
